{
  "name": "thesis-trace-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:client": "node scripts/generate-openapi-client.mjs",
    "generate:api": "npm run generate:client",
    "check:api": "node scripts/generate-openapi-client.mjs --check",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
