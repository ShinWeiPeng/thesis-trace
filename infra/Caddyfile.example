{
	admin off
}

# Replace the placeholder hostname only in deployment-owned configuration.
thesis-trace.example.invalid {
	encode zstd gzip

	@api path /api/* /health/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:8080
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
}
