# Non-secret runtime selectors only. Never place credentials or tokens here.
THESIS_TRACE_IMAGE_TAG=development
THESIS_TRACE_LOG_LEVEL=INFO
THESIS_TRACE_PUBLIC_HOSTNAME=thesis-trace.example.invalid
THESIS_TRACE_SECRETS_DIR=/etc/thesis-trace/secrets
# Fail closed until a sanitized live Cloudflare policy observation is bound.
THESIS_TRACE_RECOVERY_POLICY_VERSION=unverified
THESIS_TRACE_RECOVERY_POLICY_ENABLED=false
# Recommendation requires an explicit unit-fraction value and policy version.
# Keep release defaults absent/fail closed. The approved 5% local acceptance
# values live separately in backend/tests/fixtures/wave7-settings.env.
THESIS_TRACE_MINIMUM_ANNUALIZED_RETURN=
THESIS_TRACE_MINIMUM_RETURN_POLICY_VERSION=
